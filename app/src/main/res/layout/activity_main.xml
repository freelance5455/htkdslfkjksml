<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Coloured strip sized to the status-bar inset (set at runtime) so the status
         bar keeps its solid brand colour under edge-to-edge windows. -->
    <View
        android:id="@+id/statusBarScrim"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/colorPrimaryDark" />

    <!-- Content area: WebView -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- WebView with pull-to-refresh -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <WebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- Default loading indicator (used when the page loader isn't configured) -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Configured page loader is built programmatically into this holder -->
        <FrameLayout
            android:id="@+id/pageLoaderHolder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- ─── Floating "Made with" watermark badge ──────────────────────────── -->
        <LinearLayout
            android:id="@+id/watermarkBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginBottom="18dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_watermark"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:elevation="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">

            <TextView
                android:id="@+id/watermarkText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.01"
                android:text="Made with"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="normal" />

            <!-- Small gap between text and icon -->
            <Space
                android:layout_width="6dp"
                android:layout_height="1dp" />

            <!-- App icon on the right side -->
            <ImageView
                android:id="@+id/watermarkIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="App icon"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_watermark_logo" />

        </LinearLayout>
        <!-- ──────────────────────────────────────────────────────────────────── -->

        <!-- Preview close button (preview mode only): a faint eye watermark sits behind
             a clear close (X) so it reads as "preview", right edge, vertically centered. -->
        <FrameLayout
            android:id="@+id/previewControls"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_preview_close"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/close_preview"
            android:visibility="gone">

            <ImageView
                android:id="@+id/previewEye"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:alpha="0.28"
                android:src="@drawable/ic_eye"
                app:tint="@color/white"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/previewClose"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_close"
                app:tint="@color/white"
                android:contentDescription="@string/close_preview" />

        </FrameLayout>

    </FrameLayout>

</LinearLayout>
